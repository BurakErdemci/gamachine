#!/bin/bash
# unityai CLI wrapper — agy bunu run_command ile çağırır.
# Backend venv'i varsa onu kullanır, yoksa sistem python'ına düşer.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# WORKSPACE: env'de set değilse agy'nin çağırdığı dizini (orijinal cwd) kullan.
ORIG_PWD="$(pwd)"

# Backend's env file (UNITYAI_URL, WORKSPACE; the token is read from its own
# 0600 file). Lives in the per-user data folder, never inside the app bundle.
# Read as data, not sourced: a path with spaces, quotes or $ stays literal.
# Only those two keys are exported; any other line is ignored.
ENV_FILE="$HOME/.unity_architect_ai/.unityai_cli.env"
if [ -f "$ENV_FILE" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            ''|'#'*|=*) continue ;;
            UNITYAI_URL=*|WORKSPACE=*) export "${line%%=*}=${line#*=}" ;;
        esac
    done < "$ENV_FILE"
fi
export WORKSPACE="${WORKSPACE:-$ORIG_PWD}"

cd "$SCRIPT_DIR"

# Paketlenmiş build: yanında donmuş 'backend' binary'si varsa onu kullan (venv/python yok).
if [ -x "$SCRIPT_DIR/backend" ]; then
    exec "$SCRIPT_DIR/backend" unityai "$@"
fi

# Dev: venv python, yoksa sistem python3
if [ -f "$SCRIPT_DIR/venv/bin/python3" ]; then
    PYTHON="$SCRIPT_DIR/venv/bin/python3"
elif [ -f "$SCRIPT_DIR/venv/bin/python" ]; then
    PYTHON="$SCRIPT_DIR/venv/bin/python"
else
    PYTHON="python3"
fi

export PYTHONPATH="$SCRIPT_DIR/app${PYTHONPATH:+:$PYTHONPATH}"
exec "$PYTHON" -m app.unityai_cli "$@"
