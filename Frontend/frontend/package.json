{
  "private": true,
  "name": "gamachine",
  "description": "AI-powered Unity script generation and analysis tool",
  "version": "3.2.0",
  "author": "Burak Emre Erdemci",
  "license": "MIT",
  "main": "app/background.js",
  "scripts": {
    "predev": "node scripts/copy-monaco.js",
    "dev": "nextron --run-only",
    "predev:docker": "node scripts/copy-monaco.js",
    "dev:docker": "cross-env USE_DOCKER_BACKEND=true nextron",
    "lint:unity-hub": "python3 scripts/discover_unity_hubs.py",
    "prebuild": "node scripts/copy-monaco.js && node scripts/fetch-video-bins.js && node scripts/fetch-whisper.js && (python ../../scripts/fetch_omnisharp.py || python3 ../../scripts/fetch_omnisharp.py)",
    "build": "nextron build",
    "postinstall": "electron-builder install-app-deps && (chmod +x node_modules/node-pty/prebuilds/darwin-arm64/spawn-helper node_modules/node-pty/prebuilds/darwin-x64/spawn-helper 2>/dev/null || true)",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.13.2",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "electron-serve": "^1.3.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.562.0",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "three": "0.185.1",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.11.16",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.52",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "autoprefixer": "^10.4.19",
    "cross-env": "^10.1.0",
    "electron": "^34.0.0",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "jsdom": "^29.0.2",
    "monaco-editor": "^0.55.1",
    "next": "^14.2.4",
    "nextron": "^9.5.0",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.4"
  }
}
